.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/

# Local credentials
.env
.env.*
!.env.example

# Generated outputs
outputs/queries/*
outputs/reviews/*
outputs/exports/*
outputs/benchmark/
!outputs/queries/.gitkeep
!outputs/reviews/.gitkeep
!outputs/exports/.gitkeep

# Private benchmark material
benchmarks/fixtures/
benchmarks/private/

# Raw large local material
raw/documents/*
raw/tables/*
!raw/documents/.gitkeep
!raw/tables/.gitkeep

# Local search/index caches
.qmd/
.cache/
